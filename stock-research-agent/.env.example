# 复制为 .env 并填入真实值。.env 不会被提交（见 .gitignore）。

# Claude API —— 产业链展开 / 直觉拆解 / 框架评估
ANTHROPIC_API_KEY=

# Notion —— 观点库 / 决策记录 / 日报
NOTION_TOKEN=
NOTION_DATABASE_ID=

# 富途 FutuOpenD 网关（港股/美股持仓 + 实时）
FUTU_HOST=127.0.0.1
FUTU_PORT=11111

# IBKR（美股/中概持仓，只读）
IBKR_HOST=127.0.0.1
IBKR_PORT=7496
IBKR_CLIENT_ID=1

# 本地 SQLite 缓存路径（缺省见 src/store/db.py）
STOCKAGENT_DB=data/stockagent.db

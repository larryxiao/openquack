<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microphone capture via AVAudioEngine. Required when hardened runtime
         is enabled (i.e. for Developer ID + notarization). Without hardened
         runtime, NSMicrophoneUsageDescription in Info.plist is enough. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>

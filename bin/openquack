#!/usr/bin/env bash
#
# OpenQuack — one-command launcher
#
# Usage:
#   npx openquack              # whisper-only (default)
#   npx openquack --polish     # with LLM cleanup
#   bunx openquack --language en
#
set -e

DIR="$(cd "$(dirname "$0")/.." && pwd)"
VENV="$DIR/.venv"

# ── Bootstrap on first run ────────────────────────────────────────────
if [ ! -f "$VENV/bin/python" ]; then
    echo "  First run — setting up Local Quack..."
    echo ""

    # Check Python 3.10+
    if ! command -v python3 &>/dev/null; then
        echo "  Error: python3 not found. Install Python 3.10+ first."
        exit 1
    fi

    PY_VER=$(python3 -c "import sys; print(f'{sys.version_info.minor}')")
    if [ "$PY_VER" -lt 10 ] 2>/dev/null; then
        echo "  Error: Python 3.10+ required (found 3.$PY_VER)"
        exit 1
    fi

    python3 -m venv "$VENV"
    "$VENV/bin/pip" install -q -r "$DIR/requirements.txt"

    echo ""
    echo "  Setup complete."
    echo ""
fi

# ── Run ───────────────────────────────────────────────────────────────
exec "$VENV/bin/python" -m openquack "$@"
